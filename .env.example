# Copy to .env to override the docker-compose.yml defaults. Never commit .env.
# Placeholder dev values only: none of these is a real secret.
# Keep dev passwords URL-safe (no @ : /), because they go into DATABASE_URL.
POSTGRES_USER=officetalk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=officetalk

# Local S3 stand-in (RustFS). These are also the console login on http://localhost:9001.
S3_ACCESS_KEY=officetalk
S3_SECRET_KEY=officetalk-dev-secret
S3_BUCKET=officetalk-dev

# Local LiveKit server. Recent LiveKit versions want a secret of at least 32 characters.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=officetalk-dev-livekit-secret-placeholder
